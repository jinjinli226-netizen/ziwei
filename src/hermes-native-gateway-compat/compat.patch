+"""Shell MCP transports stay private and keep the source and owner scope they launched with."""
+from contextlib import contextmanager
+from dataclasses import asdict
+import json
+import os
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+
+def immediate(coroutine):
+    """These unit boundaries await only inline work; no listener or event loop is needed."""
+    try:
+        coroutine.send(None)
+    except StopIteration as done:
+        return done.value
+    raise AssertionError('unexpected asynchronous work')
+
+
+async def inline_thread(function, *args, **kwargs):
+    return function(*args, **kwargs)
+
+
+class ShellPrivateMcpTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='shell-private-mcp-')
+        self.addCleanup(self.temp.cleanup)
+        self.home = Path(self.temp.name)
+        self.env = patch.dict(os.environ, {'HERMES_HOME': str(self.home)})
+        self.env.start()
+        self.addCleanup(self.env.stop)
+        self.user_home = patch.object(Path, 'home', return_value=self.home)
+        self.user_home.start()
+        self.addCleanup(self.user_home.stop)
+        self.spec = {'name': 'owned-management', 'command': 'offline-peer', 'args': [],
+                     'env': [{'name': 'ACTION_TOKEN', 'value': 'SYNTHETIC_PRIVATE_A'}]}
+
+        @contextmanager
+        def discovered(authority, scope, servers, names, cwd, *, partial=False):
+            yield {f'mcp__{name}__ping': {'name': f'mcp__{name}__ping',
+                                        'parameters': {'type': 'object'}}
+                   for name in names.values()}, list(names)
+        self.transport = patch('gateway.session_local_mcp._borrowed', discovered)
+        self.transport.start()
+        self.addCleanup(self.transport.stop)
+        self.disconnect = patch('gateway.session_local_mcp._disconnect')
+        self.disconnect.start()
+        self.addCleanup(self.disconnect.stop)
+
+    def owner(self, profile='owned-profile'):
+        return SimpleNamespace(instance_id='owned', epoch=1, profile_id=profile, runner=object())
+
+    def policy(self, source, authority, sid, specs=None):
+        from gateway.session_policy import build_policy, bind_launch_key
+        private = {}
+        policy = build_policy({'source': source, 'cwd': str(self.home), 'model': 'local',
+            'toolsets': [], 'editor': {'mcp_servers': specs or [self.spec]}},
+            {'memory': {'memory_enabled': True}, 'agent': {'max_turns': 99}},
+            private_secrets=private)
+        return bind_launch_key(authority, sid, policy, None, config_secrets=private)
+
+    def test_shell_create_resume_keeps_private_transport_and_real_source(self):
+        from gateway.session_local_mcp import resume_editor_mcp
+        from gateway.session_policy import restore_policy
+        from hermes_state_runtime import RuntimeStoreError
+        for source in ('cli', 'oneshot'):
+            with self.subTest(source=source):
+                owner = self.owner()
+                policy = self.policy(source, owner, 'same-session')
+                self.assertEqual(policy.source, source)
+                self.assertEqual(policy.platform, 'cli')
+                self.assertTrue(policy.config()['memory']['memory_enabled'])
+                self.assertEqual(policy.config()['agent']['max_turns'], 99)
+                durable = json.dumps(asdict(policy))
+                self.assertNotIn('SYNTHETIC_PRIVATE_A', durable)
+                self.assertNotIn('offline-peer', durable)
+                self.assertIn('fingerprint', durable)
+                cold = self.owner()
+                cold.sessions = {'same-session': SimpleNamespace(source=object())}
+                restored = restore_policy(json.loads(durable))
+                with patch('gateway.session_policy.policy_for_source', return_value=restored):
+                    resume_editor_mcp(cold, SimpleNamespace(session_id='same-session'),
+                                      {'mcp_servers': [self.spec]})
+                    changed = json.loads(json.dumps(self.spec))
+                    changed['env'][0]['value'] = 'SYNTHETIC_PRIVATE_B'
+                    with self.assertRaisesRegex(RuntimeStoreError, 'acp_mcp_policy_conflict'):
+                        resume_editor_mcp(cold, SimpleNamespace(session_id='same-session'),
+                                          {'mcp_servers': [changed]})
+                left = json.loads(restored.editor_mcp_json)['scope']
+                right = json.loads(self.policy(source, self.owner('other-profile'),
+                                               'same-session').editor_mcp_json)['scope']
+                self.assertNotEqual(left, right)
+
+    def test_shell_rotation_uses_the_existing_fenced_mutation_preparation(self):
+        from gateway.session_local_mcp import prepare_editor_mcp, install_editor_mcp
+        for source in ('cli', 'oneshot'):
+            with self.subTest(source=source):
+                owner = self.owner()
+                policy = self.policy(source, owner, 'rotated-session')
+                changed = json.loads(json.dumps(self.spec))
+                changed['env'][0]['value'] = 'SYNTHETIC_PRIVATE_B'
+                prepared = {'snapshot': {'receipt': {'session_id': 'rotated-session',
+                                                    'policy': asdict(policy)}},
+                            'expected_revision': 7, 'expected_generation': 3}
+                with patch('asyncio.to_thread', inline_thread):
+                    result = immediate(prepare_editor_mcp(owner, None, {}, prepared,
+                                                         servers=[changed]))
+                self.assertEqual(result['expected_revision'], 7)
+                self.assertEqual(result['expected_generation'], 3)
+                self.assertEqual(result['policy']['source'], source)
+                self.assertNotIn('SYNTHETIC_PRIVATE_B', json.dumps(result))
+                with patch('hermes_state_local.local_receipt',
+                           return_value={'policy': result['policy']}):
+                    owner.db = object()
+                    install_editor_mcp(owner, 'rotated-session', [changed])
+                selected = next(iter(owner._local_editor_mcp.values()))
+                self.assertEqual(selected[0]['env'][0]['value'], 'SYNTHETIC_PRIVATE_B')
+
+    def test_shell_mcp_does_not_grant_editor_policy_or_other_surfaces(self):
+        from gateway.session_local_editor import validate_editor
+        from hermes_state_runtime import RuntimeStoreError
+        for source in ('cli', 'oneshot'):
+            with self.assertRaises(RuntimeStoreError):
+                validate_editor(source, {'mcp_servers': [self.spec],
+                                         'edit_approval_policy': 'auto'})
+        for source in ('tui', 'gui', 'tool'):
+            with self.assertRaises(RuntimeStoreError):
+                validate_editor(source, {'mcp_servers': [self.spec]})
+        validate_editor('acp', {'mcp_servers': [self.spec], 'edit_approval_policy': 'ask'})
+
+    def test_runtime_descriptor_negotiates_shell_private_mcp(self):
+        from gateway.session_controls import AuthorityConnection
+        from tui_gateway.contracts.canonical import RuntimeDescribeResult
+        owner = self.owner()
+        connection = SimpleNamespace(authority=owner)
+
+        async def ping(*_):
+            return {'pong': True}
+        connection.ping = ping
+        with patch('asyncio.to_thread', inline_thread), \
+                patch('gateway.session_skin.resolved_skin', return_value={}):
+            description = immediate(AuthorityConnection.describe(connection, None, {}))
+        self.assertIs(description['session_create']['shell_private_mcp_v1'], True)
+        self.assertIs(description['session_create']['strict_reasoning_receipts_v1'], True)
+        RuntimeDescribeResult.model_validate(description)
+
+    def test_inference_request_contract_requires_owner_binding_and_forbids_secrets(self):
+        from pydantic import ValidationError
+        from tui_gateway.contracts.registry import EVENTS
+        payload = EVENTS['inference.request'].payload
+        proof = {'schemaVersion': 1, 'model': 'local', 'provider': 'openai-codex',
+                 'requested': 'high', 'actual': 'high', 'nativeActual': 'high',
+                 'mode': 'native', 'status': 'matched', 'phase': 'request',
+                 'session_id': 's', 'profile_id': 'p', 'admission_id': 'a',
+                 'execution_generation': 3, 'authority_epoch': 27,
+                 'api_request_id': 'a' * 32}
+        payload.model_validate(proof)
+        with self.assertRaises(ValidationError):
+            payload.model_validate({key: value for key, value in proof.items()
+                                    if key != 'admission_id'})
+        with self.assertRaises(ValidationError):
+            payload.model_validate({**proof, 'api_key': 'SYNTHETIC_PRIVATE_A'})
+
+    def test_submit_contract_preserves_strict_effort_as_admission_data(self):
+        from tui_gateway.contracts.registry import CANONICAL_METHODS
+        parsed = CANONICAL_METHODS['prompt.submit'].params.model_validate(
+            {'session_id': 's', 'input_id': 'i', 'text': 'fixed',
+             'strict_reasoning_effort': 'high', 'strict_reasoning_model': 'local',
+             'strict_reasoning_provider': 'openai-codex'})
+        self.assertEqual(parsed.strict_reasoning_effort, 'high')
+        self.assertEqual(parsed.strict_reasoning_model, 'local')
+        self.assertEqual(parsed.strict_reasoning_provider, 'openai-codex')
+
+
+if __name__ == '__main__':
+    unittest.main()
