new file mode 100644
index 00000000000..182485caee2
--- /dev/null
+++ b/agent/strict_reasoning.py
@@ -0,0 +1,61 @@
+"""Opt-in, per-admission Codex wire checks. Proof contains no request body or credentials."""
+from __future__ import annotations
+
+import re
+import uuid
+
+from agent.session_client_env import strict_reasoning_route, validate_strict_effort
+
+
+def require_supported_transport(agent):
+    route = strict_reasoning_route()
+    if route is None:
+        return None
+    validate_strict_effort(route['effort'])
+    if not route.get('model') or not route.get('provider'):
+        raise ValueError('strict_reasoning_route_unavailable')
+    if (_safe_model(route['model']) is None or route['provider'] != 'openai-codex'
+            or getattr(agent, 'provider', None) != route['provider']
+            or getattr(agent, 'api_mode', None) != 'codex_responses'
+            or getattr(agent, 'model', None) != route['model']):
+        raise ValueError('strict_reasoning_unsupported_route')
+    return route
+
+
+def _safe_model(model):
+    return model if isinstance(model, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9./:_-]{0,159}', model) else None
+
+
+def guard_codex_request(agent, request):
+    """After Relay/middleware/sanitization and SDK transform bypass, immediately before create."""
+    route = require_supported_transport(agent)
+    if route is None:
+        return request
+    from hermes_constants import VALID_REASONING_EFFORTS
+    requested = route['effort']
+    extra = request.get('extra_body')
+    if extra is not None and not isinstance(extra, dict):
+        raise ValueError('strict_reasoning_invalid_extra_body')
+    wire = {**request, **(extra or {})}
+    reasoning = wire.get('reasoning')
+    actual = reasoning.get('effort') if isinstance(reasoning, dict) else None
+    native_actual, mode = actual, 'native'
+    configured = getattr(agent, 'reasoning_config', None) or {}
+    if (route['model'] == 'gpt-6.1-sol' and requested == 'max' and actual == 'xhigh'
+            and 'reasoning' not in (extra or {})
+            and configured.get('effort') == 'max' and configured.get('enabled') is not False):
+        request = {**request, 'reasoning': {**reasoning, 'effort': 'max'}}
+        actual, mode = 'max', 'verified_gpt61_sol_max'
+    matched = wire.get('model') == route['model'] and actual == requested
+    proof = {'schemaVersion': 1, 'model': _safe_model(wire.get('model')) if matched else None, 'provider': 'openai-codex',
+             'requested': requested, 'actual': actual if actual in VALID_REASONING_EFFORTS else None,
+             'nativeActual': native_actual if native_actual in VALID_REASONING_EFFORTS else None,
+             'mode': mode, 'status': 'matched' if matched else 'mismatch', 'phase': 'request',
+             'api_request_id': uuid.uuid4().hex}
+    callback = getattr(agent, 'event_callback', None)
+    if not callable(callback):
+        raise ValueError('strict_reasoning_receipt_unavailable')
+    callback('inference:request', proof)
+    if not matched:
+        raise ValueError('strict_reasoning_wire_mismatch')
+    return request
