+def publish_inference_request(turn, proof):
+    """Attach only the owner's current claim, never binding values from a request or an agent."""
+    owner = getattr(turn, '_approval_owner', None)
+    if owner is None:
+        raise ValueError('strict_reasoning_receipt_unavailable')
+    authority, session_id, generation = owner
+    stream = authority.sessions[session_id].event_stream
+    with stream.lock:
+        stamp = dict(stream.execution)
+        if (authority.executing.get(session_id) != generation
+                or stamp.get('execution_generation') != generation or not stamp.get('admission_id')):
+            raise ValueError('strict_reasoning_stale_admission')
+        payload = {key: proof[key] for key in ('schemaVersion', 'model', 'provider', 'requested', 'actual',
+                   'nativeActual', 'mode', 'status', 'phase', 'api_request_id')}
+        payload.update(session_id=session_id, profile_id=authority.profile_id,
+                       admission_id=stamp['admission_id'], authority_epoch=stamp['authority_epoch'],
+                       execution_generation=generation)
+        turn._publish_execution('inference.request', payload)
+
+
 # Launch sources whose viewer never sets the session flag; main's TUI gateway defaulted it from config.
 _CONFIG_DEFAULT_SOURCES = frozenset({"tui", "gui"})
 
