+"""Strict effort is a final SDK-boundary fact, isolated to one admitted turn."""
+from concurrent.futures import ThreadPoolExecutor
+from copy import deepcopy
+from types import SimpleNamespace
+from types import MethodType
+
+import pytest
+
+from agent.codex_runtime import run_codex_stream
+from agent.session_client_env import accept_client_env, client_env_scope, collect_client_env
+from agent.session_client_env import strict_reasoning_scope, strict_reasoning_route
+
+LEGACY_ENV = 'HERMES_STRICT_REASONING_EFFORT'
+
+
+def agent_and_sdk(*, model='gpt-6.1-sol', provider='openai-codex'):
+    events, requests = [], []
+    agent = SimpleNamespace(
+        model=model, provider=provider, api_mode='codex_responses', session_id='session-fixture',
+        reasoning_config={'enabled': True, 'effort': 'max'}, _is_codex_backend=lambda: True,
+        _interrupt_requested=False, show_commentary=True,
+        _claim_stream_writer=lambda: 1, _stream_writer_is_current=lambda _: True,
+        _fire_stream_delta=lambda _: None, _fire_reasoning_delta=lambda _: None,
+        _fire_streamed_codex_commentary=lambda _: None, interim_assistant_callback=None,
+        _touch_activity=lambda _: None, _client_log_context=lambda: 'fixture',
+        event_callback=lambda kind, payload: events.append((kind, payload)),
+    )
+
+    def create(**kwargs):
+        requests.append(kwargs)
+        final = SimpleNamespace(id='response-fixture', status='completed', usage=None, output=[],
+                                incomplete_details=None, error=None)
+        return iter([SimpleNamespace(type='response.completed', response=final)])
+
+    return agent, SimpleNamespace(responses=SimpleNamespace(create=create)), events, requests
+
+
+def merged(request):
+    return {**request, **(request.get('extra_body') or {})}
+
+
+def test_final_sdk_receives_verified_max_and_only_safe_request_evidence():
+    agent, sdk, events, requests = agent_and_sdk()
+    request = {'model': agent.model, 'reasoning': {'effort': 'xhigh'},
+               'input': [{'role': 'user', 'content': 'PRIVATE_PROMPT'}],
+               'extra_body': {'api_key': 'SYNTHETIC_PRIVATE_KEY'}}
+    with strict_reasoning_scope('max', agent.model, agent.provider):
+        run_codex_stream(agent, request, client=sdk)
+    assert merged(requests[0])['reasoning']['effort'] == 'max'
+    kind, proof = events[-1]
+    assert kind == 'inference:request'
+    assert len(proof.pop('api_request_id')) == 32
+    assert proof == {'schemaVersion': 1, 'model': agent.model, 'provider': agent.provider,
+                     'requested': 'max', 'actual': 'max', 'nativeActual': 'xhigh',
+                     'mode': 'verified_gpt61_sol_max', 'status': 'matched', 'phase': 'request'}
+    assert 'PRIVATE' not in repr(events)
+    assert request['reasoning']['effort'] == 'xhigh'
+
+
+@pytest.mark.parametrize('override', [
+    {'model': 'other-model'}, {'reasoning': {'effort': 'low'}},
+    {'extra_body': {'reasoning': {'effort': 'low'}}},
+    {'extra_body': {'reasoning': {'effort': 'xhigh'}}},
+    {'extra_body': {'model': 'other-model'}},
+])
+def test_late_middleware_or_extra_body_mismatch_never_calls_sdk(override):
+    agent, sdk, events, requests = agent_and_sdk()
+    request = {'model': agent.model, 'reasoning': {'effort': 'max'}, **override}
+    with strict_reasoning_scope('max', agent.model, agent.provider), pytest.raises(ValueError, match='strict_reasoning'):
+        run_codex_stream(agent, request, client=sdk)
+    assert requests == []
+    assert events[-1][1]['status'] == 'mismatch'
+
+
+def test_no_marker_does_not_change_request_or_emit_a_receipt():
+    agent, sdk, events, requests = agent_and_sdk()
+    with client_env_scope({}):
+        run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': 'xhigh'}}, client=sdk)
+    assert merged(requests[0])['reasoning']['effort'] == 'xhigh'
+    assert events == []
+
+
+def test_a_daemon_launch_marker_cannot_enable_strictness_for_unmarked_sessions(monkeypatch):
+    monkeypatch.setenv(LEGACY_ENV, 'max')
+    agent, sdk, events, requests = agent_and_sdk()
+    with client_env_scope(None):
+        run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': 'xhigh'}}, client=sdk)
+    assert merged(requests[0])['reasoning']['effort'] == 'xhigh'
+    assert events == []
+
+
+def test_parallel_sessions_keep_strict_effort_scoped_and_preflight_cannot_emit():
+    def run(effort):
+        agent, sdk, events, requests = agent_and_sdk()
+        with strict_reasoning_scope(effort, agent.model, agent.provider):
+            assert events == []  # A session marker/preflight is not a request.
+            run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': effort}}, client=sdk)
+        return merged(requests[0])['reasoning']['effort'], events[-1][1]['actual']
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        assert list(pool.map(run, ['high', 'max'])) == [('high', 'high'), ('max', 'max')]
+
+
+def test_arbitrary_environment_is_not_a_strict_admission_interface():
+    assert collect_client_env({LEGACY_ENV: 'high'}) == {}
+    assert accept_client_env({LEGACY_ENV: 'SYNTHETIC_PRIVATE_KEY'}, {}, local=False) == {}
+    with pytest.raises(ValueError, match='strict_reasoning'):
+        with strict_reasoning_scope('SYNTHETIC_PRIVATE_KEY', 'fixture', 'openai-codex'):
+            pass
+
+
+def test_old_session_admission_can_add_strictness_without_mutating_its_policy():
+    from gateway.session_cli_turn import admit_cli_turn, cli_turn_scope
+    committed = admit_cli_turn({'strict_reasoning_effort': 'high', 'strict_reasoning_model': 'gpt-6.1-sol',
+                               'strict_reasoning_provider': 'openai-codex'})
+    original = {'PATH': 'fixture'}
+    with client_env_scope(original):
+        with cli_turn_scope('admission-fixture', committed):
+            assert strict_reasoning_route() == {'effort': 'high', 'model': 'gpt-6.1-sol', 'provider': 'openai-codex'}
+        assert strict_reasoning_route() is None
+    assert original == {'PATH': 'fixture'}
+
+
+@pytest.mark.parametrize('override', [{'provider': 'other-provider'}, {'api_mode': 'chat_completions'},
+                                     {'model': 'fallback-model'}])
+def test_unsupported_provider_and_transport_are_refused_before_request_assembly(override):
+    from agent.turn_api_request import build_request_payload
+    agent, _, _, requests = agent_and_sdk()
+    for name, value in override.items():
+        setattr(agent, name, value)
+    with strict_reasoning_scope('high', 'gpt-6.1-sol', 'openai-codex'), pytest.raises(ValueError, match='strict_reasoning'):
+        build_request_payload(agent, api_messages=[], _moa_prepared_request=None, tools_for_api=[],
+                              system_message='', api_call_count=0, api_request_id='fixture',
+                              effective_task_id=None, turn_id='fixture')
+    assert requests == []
+
+
+def test_client_environment_cannot_activate_strictness_without_an_admission():
+    agent, sdk, events, requests = agent_and_sdk()
+    with client_env_scope({LEGACY_ENV: 'max'}):
+        run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': 'max'}}, client=sdk)
+    assert not events and len(requests) == 1
+
+
+def test_unsupported_app_server_is_refused_before_it_can_spawn():
+    from agent.codex_runtime import run_codex_app_server_turn
+    agent, _, events, requests = agent_and_sdk()
+    agent.api_mode = 'codex_app_server'
+    with strict_reasoning_scope('max', agent.model, agent.provider), pytest.raises(ValueError, match='strict_reasoning'):
+        run_codex_app_server_turn(agent, user_message='fixture', original_user_message='fixture',
+                                  messages=[], effective_task_id='fixture')
+    assert not events and not requests
+
+
+def owner_turn():
+    from gateway.session_authority import SessionAuthority
+    from gateway.session_events import SessionEvents
+    from gateway.run_turn_runner import TurnRunner
+    frames, stream = [], SessionEvents()
+    stream.execution = {'authority_epoch': 7, 'execution_generation': 5, 'admission_id': 'admission-fixture'}
+    stream.observers.add(lambda frame: frames.append(deepcopy(frame)))
+    authority = SimpleNamespace(profile_id='profile-fixture', executing={'session-fixture': 5},
+                                sessions={'session-fixture': SimpleNamespace(event_stream=stream)})
+    authority.publish_execution = MethodType(SessionAuthority.publish_execution, authority)
+    turn = object.__new__(TurnRunner)
+    turn._approval_owner = (authority, 'session-fixture', 5)
+    return turn, authority, frames
+
+
+def test_sdk_event_reaches_native_gateway_with_its_own_claim_not_agent_supplied_identity():
+    turn, _, frames = owner_turn()
+    agent, sdk, _, requests = agent_and_sdk()
+    agent.event_callback = turn._event_callback_sync
+    with client_env_scope({}), strict_reasoning_scope('max', agent.model, agent.provider):
+        run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': 'xhigh'},
+                                'input': 'PRIVATE_PROMPT'}, client=sdk)
+    assert len(requests) == len(frames) == 1
+    frame = frames[0]['params']
+    assert frame['type'] == 'inference.request'
+    for key in ('authority_epoch', 'execution_generation', 'admission_id', 'session_id'):
+        assert frame['payload'][key] == frame[key]
+    assert frame['payload']['profile_id'] == 'profile-fixture'
+    assert 'PRIVATE' not in repr(frame)
+    from tui_gateway.contracts.registry import EVENTS
+    EVENTS['inference.request'].payload.model_validate(frame['payload'])
+
+
+def test_retired_gateway_claim_does_not_send_an_sdk_request_or_borrow_a_new_admission():
+    turn, authority, frames = owner_turn()
+    authority.executing['session-fixture'] = 6
+    agent, sdk, _, requests = agent_and_sdk()
+    agent.event_callback = turn._event_callback_sync
+    with strict_reasoning_scope('max', agent.model, agent.provider), pytest.raises(ValueError, match='stale_admission'):
+        run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': 'max'}}, client=sdk)
+    assert requests == frames == []
+
+
+@pytest.mark.parametrize('epoch', [0, 7])
+def test_view_only_emits_current_admission_proof_from_verified_outer_binding(capsys, epoch):
+    from hermes_cli.gateway_chat_view import GatewayChatView
+    turn, _, frames = owner_turn()
+    agent, sdk, _, _ = agent_and_sdk()
+    agent.event_callback = turn._event_callback_sync
+    with strict_reasoning_scope('max', agent.model, agent.provider):
+        run_codex_stream(agent, {'model': agent.model, 'reasoning': {'effort': 'max'}}, client=sdk)
+    correct = frames[0]
+    correct['params']['authority_epoch'] = correct['params']['payload']['authority_epoch'] = epoch
+    other_session, other_admission, other_profile, stale, other_epoch = (deepcopy(correct) for _ in range(5))
+    other_session['params']['session_id'] = 'other-session'
+    other_admission['params']['admission_id'] = other_admission['params']['payload']['admission_id'] = 'other-admission'
+    other_profile['params']['payload']['profile_id'] = 'other-profile'
+    stale['params']['execution_generation'] = stale['params']['payload']['execution_generation'] = 3
+    other_epoch['params']['authority_epoch'] = other_epoch['params']['payload']['authority_epoch'] = epoch + 1
+    sequence = iter([other_session, other_admission, other_profile, stale, other_epoch, correct, RuntimeError('end')])
+
+    class Events:
+        async def get(self):
+            return next(sequence)
+
+    view = GatewayChatView(SimpleNamespace(events=Events()), {
+        'stored_session_id': 'session-fixture', 'profile_id': 'profile-fixture',
+        'authority_epoch': epoch, 'execution_generation': 4})
+    view.finite, view.finite_admission = True, 'admission-fixture'
+    received = []
+    view.inference_request_callback = lambda payload, binding: received.append((payload, binding))
+    # All fake I/O completes inline: Windows' event-loop socketpair is unnecessary.
+    with pytest.raises(StopIteration):
+        view.render().send(None)
+    assert len(received) == 1
+    payload, binding = received[0]
+    assert binding == {key: payload[key] for key in ('session_id', 'profile_id', 'admission_id',
+                      'authority_epoch', 'execution_generation', 'api_request_id')}
+    view.inference_request_callback = None
+    view._inference_request('admission-fixture', {**payload, '_native_binding': binding,
+                                               'arbitrary_secret': 'PRIVATE_KEY'})
+    assert capsys.readouterr().err.startswith('HERMES_INFERENCE_REQUEST:')
